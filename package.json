{
  "name": "@infinity-explainer/core",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dev:mcp": "node --watch server/index.ts",
    "start:mcp": "node server/index.ts",
    "setup:mcp": "npm install --prefix server",
    "check:mcp": "tsc -p server/tsconfig.json",
    "test": "node --test server/*.test.ts tests/reading.test.ts tests/llm.test.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:ui": "npm run build && node --test --test-concurrency=1 tests/ui.test.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.103",
    "@ai-sdk/cohere": "^4.0.82",
    "@ai-sdk/deepseek": "^3.0.85",
    "@ai-sdk/google": "^4.0.119",
    "@ai-sdk/groq": "^4.0.82",
    "@ai-sdk/mistral": "^4.0.85",
    "@ai-sdk/openai": "^4.0.116",
    "@ai-sdk/openai-compatible": "^3.0.91",
    "@ai-sdk/xai": "^5.0.44",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@modelcontextprotocol/client": "^2.3.1",
    "@openai/apps-sdk-ui": "^0.2.2",
    "ai": "^7.0.171",
    "codemirror-markdown-hybrid": "^1.2.2",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "marked": "^14.1.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^9.39.4",
    "@rolldown/plugin-babel": "^0.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@openai/apps-sdk-ui": {
      "lodash": "4.18.1"
    },
    "katex": "$katex",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "pnpm": {
    "overrides": {
      "@openai/apps-sdk-ui>lodash": "4.18.1",
      "katex": "$katex",
      "@typescript-eslint/typescript-estree>minimatch": "11.0.5"
    }
  },
  "version": "0.1.0",
  "description": "An interactive explanation canvas for local models and agent integrations.",
  "exports": {
    "./app": "./src/App.tsx",
    "./mount": "./src/main.tsx",
    "./runtime": "./src/services/CanvasHost.ts",
    "./*": "./*"
  }
}
